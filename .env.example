# Local development needs no environment variables.
# For a private pilot, set these in your hosting provider's secret settings:
HOST=0.0.0.0
PILOT_MODE=true
PILOT_USERNAME=
PILOT_PASSWORD=
# Optional bounded Gemini worker (server only, never exposed to the browser):
GEMINI_API_KEY=
GEMINI_MODEL=
# PORT is supplied by the hosting provider. Default for local work: 8000.
