PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Exact public origin, required when behind a reverse proxy
APP_ORIGIN=http://localhost:3000
# Register this email to obtain reviewer and room moderator permissions
ADMIN_EMAIL=your-email@example.com
# AI is disabled until both values are configured
GEMINI_API_KEY=
GEMINI_MODEL=
# Secure cookies on HTTPS
COOKIE_SECURE=false
# Optional JSON array from a TURN provider for cross-network calling
# ICE_SERVERS_JSON=[{"urls":"turn:example.org:3478","username":"...","credential":"..."}]
# Shown to customers; set your actual mobile money instructions before sales
PAYMENT_INSTRUCTIONS=
# Required only for designated reviewer registration; use a long random secret
ADMIN_SETUP_TOKEN=
