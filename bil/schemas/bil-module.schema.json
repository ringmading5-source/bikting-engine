{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bikting.local/schemas/bil-module.schema.json",
  "title": "Bikting Intent Language Module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "name", "description", "appliesWhen", "intents", "concepts", "relationships", "reasoningStrategies", "capabilityRequirements", "constraints", "executionRequirements", "verificationRequirements", "outputRequirements"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "kind": { "enum": ["reasoning", "knowledge", "capability", "workflow", "output", "constraint"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "appliesWhen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intents": { "$ref": "#/$defs/idArray" },
        "allConcepts": { "$ref": "#/$defs/idArray" },
        "anyConcepts": { "$ref": "#/$defs/idArray" },
        "allRequestedCapabilities": { "$ref": "#/$defs/idArray" },
        "anyRequestedCapabilities": { "$ref": "#/$defs/idArray" },
        "allRequestedOutputs": { "$ref": "#/$defs/idArray" },
        "anyRequestedOutputs": { "$ref": "#/$defs/idArray" },
        "modalities": { "$ref": "#/$defs/idArray" },
        "contextEquals": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "relationships": { "type": "array", "items": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } } } }
      }
    },
    "intents": { "$ref": "#/$defs/idArray" },
    "concepts": { "type": "array", "items": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "description": { "type": "string" } } } },
    "relationships": { "type": "array", "items": { "type": "object", "required": ["id", "type", "from", "to"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "weight": { "type": "number" }, "metadata": { "type": "object" }, "source": { "type": "string" } }, "additionalProperties": false } },
    "reasoningStrategies": { "type": "array", "items": { "type": "object", "required": ["id", "type"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["deterministic", "model_assisted", "retrieve_then_reason"] }, "description": { "type": "string" }, "requiredContext": { "$ref": "#/$defs/idArray" } } } },
    "capabilityRequirements": { "type": "array", "items": { "type": "object", "required": ["capabilityId", "required"], "additionalProperties": false, "properties": { "capabilityId": { "$ref": "#/$defs/id" }, "required": { "type": "boolean" }, "purpose": { "type": "string" } } } },
    "knowledgeRequirements": { "type": "array", "items": { "type": "object", "required": ["id", "concepts", "freshness", "required"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "domain": { "$ref": "#/$defs/id" }, "concepts": { "$ref": "#/$defs/idArray" }, "topic": { "type": "string" }, "relationshipTypes": { "$ref": "#/$defs/idArray" }, "freshness": { "enum": ["stable", "recent", "live", "project_current"] }, "minimumAuthority": { "type": "number" }, "allowedSourceTypes": { "$ref": "#/$defs/idArray" }, "accessRequirementIds": { "$ref": "#/$defs/idArray" }, "requireProvenance": { "type": "boolean" }, "minimumConfidence": { "type": "number" }, "evidenceRequired": { "type": "boolean" }, "required": { "type": "boolean" } } } },
      "workflow": { "type": "object", "required": ["id", "steps"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "capabilityId"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "dependsOn": { "$ref": "#/$defs/idArray" }, "description": { "type": "string" }, "inputBindings": { "type": "array", "items": { "$ref": "#/$defs/inputBinding" } } } } } } },
    "constraints": { "type": "array", "items": { "type": "object", "required": ["type", "value"], "additionalProperties": false, "properties": { "type": { "$ref": "#/$defs/id" }, "value": true } } },
    "executionRequirements": { "type": "array", "items": { "type": "object", "required": ["id", "type"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/id" }, "value": { "type": ["string", "number", "boolean", "array"], "items": { "type": "string" } }, "required": { "type": "boolean" } } } },
    "verificationRequirements": { "type": "array", "items": { "type": "object", "required": ["id", "method", "required"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "method": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "required": { "type": "boolean" }, "description": { "type": "string" } } } },
    "outputRequirements": { "type": "array", "items": { "type": "object", "required": ["id", "type", "required"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "required": { "type": "boolean" } } } },
    "moduleReferences": { "type": "array", "items": { "type": "object", "required": ["moduleId", "version"], "additionalProperties": false, "properties": { "moduleId": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^(?:\\^)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" } } } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "inputBinding": { "type": "object", "required": ["target", "source"], "additionalProperties": false, "properties": { "target": { "type": "string", "minLength": 1 }, "source": { "oneOf": [{ "type": "object", "required": ["type", "path"], "additionalProperties": false, "properties": { "type": { "enum": ["intent", "context"] }, "path": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }, { "type": "object", "required": ["type", "value"], "additionalProperties": false, "properties": { "type": { "const": "literal" }, "value": true } }, { "type": "object", "required": ["type", "stepId", "path"], "additionalProperties": false, "properties": { "type": { "const": "step_output" }, "stepId": { "$ref": "#/$defs/id" }, "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }] } } }
  }
}
