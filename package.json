{
  "name": "bikting-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "prestart": "npm run build:runtime",
    "start": "node --check src/main.js && node server.js",
    "pretest": "npm run build:runtime",
    "test": "node --test tests/*.test.js",
    "test:architecture": "node scripts/run-architecture-tests.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run test:architecture && npm run typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "plotly.js-dist-min": "^4.1.1"
  }
}
